# Copy to .env.local and fill in. Leave blank to run without the integration.

# Google reviews (Places API, New). Enable "Places API (New)" in Google Cloud, create an API key
# restricted to that API, and find the Place ID at
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Booking requests are emailed through Resend (https://resend.com). Without a key the booking form
# tells visitors to call instead of pretending the booking went through.
RESEND_API_KEY=
# Optional: defaults to autospakelowna@gmail.com and Resend's test sender.
BOOKING_TO=
BOOKING_FROM=
